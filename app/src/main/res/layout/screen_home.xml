<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RAM Monitor" android:textColor="#17243A" android:textSize="27sp" android:textStyle="bold" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Состояние оперативной памяти" android:textColor="#526176" android:textSize="15sp" />
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardCornerRadius="18dp" app:cardElevation="2dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
    <TextView android:id="@+id/tvUsedRam" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Используется: —" android:textColor="#17243A" android:textSize="21sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvAvailableRam" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Свободно: —" android:textColor="#526176" android:textSize="15sp" />
    <TextView android:id="@+id/tvTotalRam" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Всего: —" android:textColor="#526176" android:textSize="15sp" />
    <ProgressBar android:id="@+id/ramProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="16dp" android:max="100" android:progress="0" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
   <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" app:cardCornerRadius="14dp"><LinearLayout android:padding="14dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:text="Снимки" android:textColor="#64748B" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/tvSnapshotCount" android:text="—" android:textColor="#17243A" android:textSize="24sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout></com.google.android.material.card.MaterialCardView>
   <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" app:cardCornerRadius="14dp"><LinearLayout android:padding="14dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:text="Приложения" android:textColor="#64748B" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/tvAppCount" android:text="—" android:textColor="#17243A" android:textSize="24sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout></com.google.android.material.card.MaterialCardView>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Последнее измерение" android:textColor="#17243A" android:textSize="18sp" android:textStyle="bold" />
  <TextView android:id="@+id/tvLastSnapshot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="История пока не накоплена" android:textColor="#64748B" android:textSize="14sp" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btnCapture" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Снять показания сейчас" />
 </LinearLayout>
</ScrollView>